# Copy to .env (git-ignored) and fill in. Used by the scripts in scaleway/.

# --- Scaleway ---
SCW_DEFAULT_REGION=fr-par
SCW_REGISTRY_NAMESPACE=playwright-tests
SCW_JOB_NAME=practiceautomatedtesting-e2e
SCW_JOB_CPU=1000
SCW_JOB_MEMORY=2048
SCW_JOB_STORAGE=5000
SCW_FUNCTION_NAMESPACE=playwright-ci
# Output of ./scaleway/ensure-job.sh
JOB_DEFINITION_ID=
# API key the controller uses to start jobs (least privilege: ServerlessJobsFullAccess).
# Empty = your scw CLI key.
CONTROLLER_SCW_SECRET_KEY=

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=./github-app.private-key.pem
# openssl rand -hex 32  (same value in the GitHub App webhook settings)
GITHUB_WEBHOOK_SECRET=

# --- Tests ---
BASE_URL=https://www.practiceautomatedtesting.com
# Repos allowed to start runs (owner/repo, comma-separated). Anything else is refused.
ALLOWED_REPOS=learn-automated-testing/scaleway-playwright
# Comma-separated branches that trigger tests; empty = every branch
BRANCHES=

# --- Reports (optional) ---
REPORT_BUCKET=
# API key with ObjectStorageFullAccess (used by the job to upload reports)
REPORT_ACCESS_KEY=
REPORT_SECRET_KEY=
